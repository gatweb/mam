# Copier vers .env puis adapter — et générer les secrets :
#   sed -i "s/CHANGEME1/$(openssl rand -hex 16)/; s/CHANGEME2/$(openssl rand -hex 16)/; s/CHANGEME3/$(openssl rand -hex 16)/" .env

# URL publique du serveur Jitsi (celle à mettre dans Admin → Appels vidéo)
PUBLIC_URL=https://meet.votre-domaine.tld

# IPs annoncées par le pont vidéo (JVB) : IP locale du serveur, et IP publique
# de la box si vous appelez depuis l'extérieur. Séparées par une virgule.
JVB_ADVERTISE_IPS=192.168.0.60,VOTRE.IP.PUBLIQUE

# Ports exposés sur l'hôte
HTTP_PORT=8100
HTTPS_PORT=8443
JVB_PORT=10000

TZ=Europe/Brussels

# Secrets internes (générer avec openssl rand -hex 16)
JICOFO_COMPONENT_SECRET=CHANGEME1
JICOFO_AUTH_PASSWORD=CHANGEME2
JVB_AUTH_PASSWORD=CHANGEME3
